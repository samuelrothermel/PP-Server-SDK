<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/styles/custom.css">
  <link rel="stylesheet" href="/styles/invoicing.css">
  <title>PayPal Invoicing Demo — CPQ Pay-by-Link</title>
</head>
<body>
  <div class="container">
    <header class="inv-header">
      <div class="inv-header-title">
        <h1>PayPal Invoicing — CPQ Pay-by-Link Demo</h1>
        <p>Simulate a sales associate generating an invoice and sharing a pay link — no customer email required.</p>
      </div>
      <a href="/" class="btn-secondary btn-sm">← Back to Dashboard</a>
    </header>

    <!-- Credentials Panel -->
    <div class="inv-section">
      <h2>Sandbox Credentials</h2>
      <p class="inv-hint">Enter your <a href="https://developer.paypal.com/dashboard/applications/sandbox" target="_blank">PayPal Sandbox app</a> credentials. These are sent to your own server and never stored.</p>
      <div class="inv-creds-grid">
        <div class="form-group">
          <label for="clientId">Client ID</label>
          <input type="text" id="clientId" placeholder="Aabc123…" autocomplete="off">
        </div>
        <div class="form-group">
          <label for="clientSecret">Client Secret</label>
          <input type="password" id="clientSecret" placeholder="EKlm456…" autocomplete="off">
        </div>
      </div>
    </div>

    <!-- Main Layout: CPQ Form + Status Panel -->
    <div class="inv-main-layout">

      <!-- LEFT: CPQ Order Summary -->
      <div class="inv-section inv-cpq-panel">
        <h2>CPQ Order Summary</h2>

        <div class="form-group">
          <label for="customerEmail">Customer Email (Sandbox Buyer Account)</label>
          <input type="email" id="customerEmail" placeholder="buyer@example.com" value="">
          <span class="inv-hint">Use a <a href="https://developer.paypal.com/dashboard/accounts" target="_blank">sandbox buyer account</a> email.</span>
        </div>

        <div class="form-group">
          <label for="customerName">Customer Name</label>
          <input type="text" id="customerName" placeholder="Acme Corp" value="Acme Corp">
        </div>

        <div class="form-group">
          <label for="invoiceCurrency">Currency</label>
          <select id="invoiceCurrency">
            <option value="USD" selected>USD — US Dollar</option>
            <option value="EUR">EUR — Euro</option>
            <option value="GBP">GBP — British Pound</option>
            <option value="CAD">CAD — Canadian Dollar</option>
            <option value="AUD">AUD — Australian Dollar</option>
          </select>
        </div>

        <h3>Line Items</h3>
        <div id="lineItemsContainer">
          <div class="inv-line-item">
            <input type="text"   class="li-name"     placeholder="Item name"  value="Enterprise License">
            <input type="number" class="li-qty"      placeholder="Qty"        value="1"    min="1" step="1">
            <input type="number" class="li-price"    placeholder="Unit price" value="1500" min="0" step="0.01">
            <button class="btn-icon" onclick="removeLineItem(this)" title="Remove">✕</button>
          </div>
          <div class="inv-line-item">
            <input type="text"   class="li-name"     placeholder="Item name"  value="Implementation Services">
            <input type="number" class="li-qty"      placeholder="Qty"        value="3"    min="1" step="1">
            <input type="number" class="li-price"    placeholder="Unit price" value="500"  min="0" step="0.01">
            <button class="btn-icon" onclick="removeLineItem(this)" title="Remove">✕</button>
          </div>
        </div>
        <button class="btn-secondary btn-sm" onclick="addLineItem()" style="margin-top:8px;">+ Add Line Item</button>

        <div class="inv-totals">
          <div class="inv-total-row">
            <span>Subtotal</span>
            <span id="subtotalDisplay">—</span>
          </div>
          <div class="inv-total-row inv-total-row--grand">
            <span>Total</span>
            <span id="grandTotalDisplay">—</span>
          </div>
        </div>

        <div class="form-group" style="margin-top:16px;">
          <label for="invoiceNote">Note to Customer (optional)</label>
          <textarea id="invoiceNote" rows="2" placeholder="Thank you for your business.">Thank you for your business.</textarea>
        </div>

        <button class="btn-primary inv-send-btn" id="generateBtn" onclick="generatePayLink()">
          Generate Pay Link
        </button>
      </div>

      <!-- RIGHT: Status Panel with Tabs -->
      <div class="inv-status-panel">

        <!-- Pay Link Tab -->
        <div class="inv-tab-bar">
          <button class="inv-tab active" data-tab="link">Pay Link</button>
          <button class="inv-tab" data-tab="status">Payment Status</button>
          <button class="inv-tab" data-tab="webhook">Webhook Log</button>
        </div>

        <!-- Tab: Pay Link -->
        <div class="inv-tab-content active" id="tab-link">
          <div id="payLinkEmpty" class="inv-empty-state">
            <div class="inv-empty-icon">🔗</div>
            <p>Fill in the form and click <strong>Generate Pay Link</strong> to create a sandbox invoice and get the payer URL instantly — no customer email needed.</p>
          </div>
          <div id="payLinkResult" style="display:none;">
            <div class="inv-success-badge">✓ Invoice Created</div>
            <div class="inv-meta" id="invoiceMeta"></div>
            <label class="inv-label">Pay Link (open in incognito as sandbox buyer)</label>
            <div class="inv-link-box">
              <input type="text" id="payLinkUrl" readonly>
              <button class="btn-secondary btn-sm" onclick="copyPayLink()">Copy</button>
              <a id="payLinkOpen" href="#" target="_blank" class="btn-primary btn-sm">Open ↗</a>
            </div>
            <p class="inv-hint" style="margin-top:8px;">Open in an incognito window, log in as your sandbox buyer, and complete the payment.</p>
          </div>
          <div id="payLinkError" class="inv-error-box" style="display:none;"></div>
          <div id="payLinkLoading" class="inv-loading" style="display:none;">
            <div class="inv-spinner"></div>
            <span>Calling PayPal APIs…</span>
          </div>
        </div>

        <!-- Tab: Payment Status -->
        <div class="inv-tab-content" id="tab-status">
          <div id="statusEmpty" class="inv-empty-state">
            <div class="inv-empty-icon">📋</div>
            <p>Generate a pay link first, then start polling to detect when the sandbox buyer completes payment.</p>
          </div>
          <div id="statusPanel" style="display:none;">
            <div class="inv-poll-controls">
              <button class="btn-primary" id="pollBtn" onclick="togglePolling()">Start Polling</button>
              <span class="inv-poll-interval">Checking every 5 seconds</span>
            </div>
            <div class="inv-status-badge-wrap">
              <span class="inv-status-badge" id="paymentStatusBadge">UNPAID</span>
            </div>
            <div id="statusHistory" class="inv-status-history"></div>
          </div>
        </div>

        <!-- Tab: Webhook Log -->
        <div class="inv-tab-content" id="tab-webhook">
          <div class="inv-webhook-header">
            <div class="inv-webhook-tip" style="margin-bottom:12px;">
              <strong>Real webhook delivery:</strong> PayPal sends <code>INVOICING.INVOICE.PAID</code> to <code>POST /api/webhooks</code> on this server. This tab polls for it every 5 s and displays the live payload when it arrives. To receive real sandbox events, expose this server publicly (e.g. with <a href="https://ngrok.com" target="_blank">ngrok</a>) and register the URL in the <a href="https://developer.paypal.com/dashboard/webhooks/sandbox" target="_blank">PayPal Webhook Simulator</a>.
            </div>
          </div>

          <!-- Real webhook panel -->
          <div id="webhookEmpty" class="inv-empty-state">
            <div class="inv-empty-icon">⚡</div>
            <p>Generate an invoice first, then complete payment. This panel will show the live <code>INVOICING.INVOICE.PAID</code> webhook payload when your server receives it.</p>
          </div>

          <!-- Waiting state (invoice created, watching for webhook) -->
          <div id="webhookWaiting" style="display:none;">
            <div class="inv-webhook-waiting">
              <div class="inv-spinner"></div>
              <div>
                <strong>Listening for webhook…</strong>
                <p class="inv-hint" style="margin:4px 0 0;">Polling <code>GET /api/invoicing/webhook-events/:invoiceId</code> every 5 s. Complete payment in your incognito window to trigger the event.</p>
              </div>
            </div>
          </div>

          <!-- Real event received -->
          <div id="webhookLive" style="display:none;">
            <div class="inv-success-badge" style="margin-bottom:12px;">✓ Real webhook received</div>
            <div class="inv-webhook-event">
              <div class="inv-webhook-event-header">
                <span class="inv-webhook-type" id="webhookLiveType">INVOICING.INVOICE.PAID</span>
                <span class="inv-webhook-time" id="webhookLiveTime"></span>
              </div>
              <pre id="webhookLivePayload" class="inv-code-block"></pre>
            </div>
          </div>

          <!-- Simulated payload (always shown once invoice is created, below real one) -->
          <div id="webhookSimSection" style="display:none; margin-top:20px;">
            <details>
              <summary class="inv-sim-toggle">Simulated payload (reference)</summary>
              <div class="inv-webhook-event" style="margin-top:10px;">
                <div class="inv-webhook-event-header">
                  <span class="inv-webhook-type" id="webhookType">INVOICING.INVOICE.PAID</span>
                  <span class="inv-webhook-time" id="webhookTime"></span>
                </div>
                <pre id="webhookPayload" class="inv-code-block"></pre>
              </div>
            </details>
          </div>
        </div>

      </div>
    </div>

    <!-- API Call Log -->
    <div class="inv-section" style="margin-top:24px;">
      <h2>API Call Log</h2>
      <p class="inv-hint">Real PayPal Sandbox API calls made by this demo.</p>
      <div id="apiLog" class="inv-api-log">
        <div class="inv-api-log-empty">No API calls yet.</div>
      </div>
    </div>

    <!-- Developer Resources -->
    <div class="inv-section info-box" style="margin-top:24px;">
      <h3>Developer Resources — Invoicing API</h3>
      <div class="inv-resources-grid">
        <ul>
          <li><a href="https://developer.paypal.com/docs/invoicing/" target="_blank">Invoicing API Overview</a></li>
          <li><a href="https://developer.paypal.com/api/invoicing/v2/" target="_blank">Invoicing REST API Reference (v2)</a></li>
          <li><a href="https://developer.paypal.com/docs/invoicing/integrate/" target="_blank">Integration Guide</a></li>
        </ul>
        <ul>
          <li><a href="https://developer.paypal.com/dashboard/webhooks/sandbox" target="_blank">Webhook Simulator (Sandbox)</a></li>
          <li><a href="https://developer.paypal.com/dashboard/accounts" target="_blank">Sandbox Accounts</a></li>
          <li><a href="https://developer.paypal.com/docs/api/reference/api-responses/" target="_blank">Error Codes Reference</a></li>
        </ul>
      </div>
    </div>

  </div>

  <script src="/invoicing.js"></script>
</body>
</html>
