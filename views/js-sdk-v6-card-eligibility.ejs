<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="stylesheet" type="text/css" href="/styles/custom.css" />
  <title>JS SDK v6 — Card Eligibility Testing</title>
  <style>
    .page-header { text-align: center; margin-bottom: 32px; }
    .page-header h1 { font-size: 2em; margin-bottom: 8px; color: #1a1a1a; }
    .page-header .badge-row { display: flex; justify-content: center; gap: 8px; margin-bottom: 8px; }
    .page-header p { color: #666; margin: 0; }

    .back-link {
      display: inline-flex; align-items: center; gap: 6px;
      color: #0070ba; text-decoration: none; font-size: 0.9em; margin-bottom: 24px;
    }
    .back-link:hover { text-decoration: underline; }

    .run-btn {
      width: 100%;
      padding: 10px;
      background: #0070ba;
      color: #fff;
      border: none;
      border-radius: 6px;
      font-size: 0.95em;
      font-weight: 600;
      cursor: pointer;
    }
    .run-btn:hover { background: #005ea6; }
    .run-btn:disabled { background: #aaa; cursor: not-allowed; }

    .status-area {
      padding: 10px 12px;
      border-radius: 6px;
      font-size: 0.85em;
      display: none;
    }
    .status-area.info    { background: #e8f4fd; border: 1px solid #bee3f8; color: #2b6cb0; display: block; }
    .status-area.success { background: #f0fff4; border: 1px solid #9ae6b4; color: #276749; display: block; }
    .status-area.error   { background: #fff5f5; border: 1px solid #feb2b2; color: #c53030; display: block; }

    /* Results */
    .results-area { display: flex; flex-direction: column; gap: 20px; }

    .result-section {
      border: 1px solid #e0e0e0;
      border-radius: 10px;
      overflow: hidden;
      background: #fff;
    }
    .result-section-header {
      padding: 14px 20px;
      border-bottom: 1px solid #e0e0e0;
      background: #f8f9fa;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .result-section-header h3 { margin: 0; font-size: 0.95em; color: #333; font-weight: 600; }
    .section-tag {
      font-size: 0.75em;
      padding: 2px 8px;
      border-radius: 10px;
      font-weight: 600;
    }
    .tag-guest    { background: #dbeafe; color: #1e3a8a; }
    .tag-advanced { background: #e9d8fd; color: #6b21a8; }

    .result-body { padding: 0; }

    .candidate-table { width: 100%; border-collapse: collapse; font-size: 0.88em; }
    .candidate-table th {
      text-align: left;
      padding: 8px 16px;
      background: #fafafa;
      border-bottom: 2px solid #e0e0e0;
      color: #555;
      font-size: 0.8em;
      text-transform: uppercase;
      letter-spacing: 0.4px;
    }
    .candidate-table td {
      padding: 8px 16px;
      border-bottom: 1px solid #f0f0f0;
      vertical-align: top;
    }
    .candidate-table tr:last-child td { border-bottom: none; }

    .candidate-key {
      font-family: 'Courier New', monospace;
      background: #f4f4f4;
      padding: 2px 6px;
      border-radius: 4px;
      color: #333;
    }
    .badge-true  { display: inline-block; background: #d1fae5; color: #065f46; border: 1px solid #6ee7b7; border-radius: 4px; padding: 1px 8px; font-size: 0.85em; font-weight: 700; }
    .badge-false { display: inline-block; background: #fee2e2; color: #991b1b; border: 1px solid #fca5a5; border-radius: 4px; padding: 1px 8px; font-size: 0.85em; font-weight: 700; }

    .details-block {
      margin: 4px 0 0;
      background: #1e1e1e;
      color: #d4d4d4;
      border-radius: 6px;
      padding: 10px 14px;
      font-family: 'Courier New', monospace;
      font-size: 0.82em;
      line-height: 1.5;
      overflow: auto;
      max-height: 180px;
    }

    .empty-state {
      padding: 20px 16px;
      color: #aaa;
      font-size: 0.88em;
      font-style: italic;
    }
  </style>
</head>
<body>
  <div class="container">

    <a href="/" class="back-link">← Back to Dashboard</a>

    <div class="page-header">
      <div class="badge-row">
        <span class="sdk-badge js-sdk-v6">⬡ JS SDK v6</span>
      </div>
      <h1>Card Eligibility Testing</h1>
      <p>Test <code>isEligible()</code> keys for Guest Card Fields (BCDC) and Advanced Card Fields (ACDC).</p>
    </div>

    <div style="max-width: 600px; margin: 0 auto;">
      <div style="text-align:center; margin-bottom: 20px;">
        <button id="run-btn" class="run-btn" style="width:auto; padding: 10px 32px;">Run Tests</button>
        <div id="status-area" class="status-area" style="margin-top: 12px;"></div>
      </div>

      <!-- Results -->
      <div class="results-area">

        <!-- Guest / BCDC -->
        <div class="result-section">
          <div class="result-section-header">
            <h3>Guest Card Fields (BCDC)</h3>
            <span class="section-tag tag-guest">BCDC</span>
          </div>
          <div class="result-body">
            <table class="candidate-table">
              <thead>
                <tr>
                  <th>Key</th>
                  <th>isEligible()</th>
                  <th>getDetails()</th>
                </tr>
              </thead>
              <tbody id="guest-rows">
                <tr><td colspan="3" class="empty-state">Click "Run Tests" to see results.</td></tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Advanced / ACDC -->
        <div class="result-section">
          <div class="result-section-header">
            <h3>Advanced Card Fields (ACDC)</h3>
            <span class="section-tag tag-advanced">ACDC</span>
          </div>
          <div class="result-body">
            <table class="candidate-table">
              <thead>
                <tr>
                  <th>Key</th>
                  <th>isEligible()</th>
                  <th>getDetails()</th>
                </tr>
              </thead>
              <tbody id="advanced-rows">
                <tr><td colspan="3" class="empty-state">Click "Run Tests" to see results.</td></tr>
              </tbody>
            </table>
          </div>
        </div>

      </div>
    </div>

  </div>

  <script src="https://www.sandbox.paypal.com/web-sdk/v6/core"></script>
  <script>const CLIENT_ID = '<%= clientId %>';</script>
  <script src="/js-sdk-v6-card-eligibility.js"></script>
</body>
</html>
